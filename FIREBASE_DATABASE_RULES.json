{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false,
        ".validate": "newData.isBoolean()"
      }
    },
    "bookings": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        "$bookingId": {
          ".write": "auth != null && ((auth.uid === $uid && ((!data.exists() && newData.exists() && newData.child('status').val() === 'pending') || (data.exists() && data.child('status').val() === 'pending' && ((!newData.exists()) || (newData.child('status').val() === 'pending' && newData.child('emailStatus').val() === data.child('emailStatus').val() && newData.child('userId').val() === $uid && newData.child('bookingId').val() === $bookingId && newData.child('createdAt').val() === data.child('createdAt').val())))) || root.child('admins').child(auth.uid).val() === true)",
          ".validate": "!newData.exists() || newData.hasChildren(['bookingId','userId','customerName','customerEmail','customerPhone','customerCity','eventName','eventType','eventDate','eventTime','guestCount','eventCity','venuePreference','preferredVenue','eventBudget','servicePreference','eventRequirements','status','emailStatus','createdAt','updatedAt'])",
          "bookingId": {
            ".validate": "newData.isString() && newData.val() === $bookingId"
          },
          "userId": {
            ".validate": "newData.isString() && newData.val() === $uid"
          },
          "customerName": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120"
          },
          "customerEmail": {
            ".validate": "newData.isString() && newData.val().length <= 254"
          },
          "customerPhone": {
            ".validate": "newData.isString() && newData.val().length <= 30"
          },
          "customerCity": {
            ".validate": "newData.isString() && newData.val().length <= 100"
          },
          "eventName": {
            ".validate": "newData.isString() && newData.val().length <= 150"
          },
          "eventType": {
            ".validate": "newData.isString() && newData.val().length <= 100"
          },
          "eventDate": {
            ".validate": "newData.isString() && newData.val().length <= 30"
          },
          "eventTime": {
            ".validate": "newData.isString() && newData.val().length <= 50"
          },
          "guestCount": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100000"
          },
          "eventCity": {
            ".validate": "newData.isString() && newData.val().length <= 100"
          },
          "venuePreference": {
            ".validate": "newData.isString() && newData.val().length <= 100"
          },
          "preferredVenue": {
            ".validate": "newData.isString() && newData.val().length <= 200"
          },
          "eventBudget": {
            ".validate": "newData.isString() && newData.val().length <= 100"
          },
          "servicePreference": {
            ".validate": "newData.isString() && newData.val().length <= 200"
          },
          "eventRequirements": {
            ".validate": "newData.isString() && newData.val().length <= 5000"
          },
          "status": {
            ".validate": "newData.val() === 'pending' || (auth != null && root.child('admins').child(auth.uid).val() === true && (newData.val() === 'approved' || newData.val() === 'rejected'))"
          },
          "emailStatus": {
            ".validate": "newData.val() === 'not_sent' || newData.val() === 'sent'"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && (newData.val() === data.val() || !data.exists())"
          },
          "updatedAt": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "events": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$eventId": {
        ".validate": "!newData.exists() || newData.hasChildren(['title','name','type','updatedAt'])",
        "title": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "category": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "location": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "price": {
          ".validate": "newData.val() === null || newData.isNumber()"
        },
        "description": {
          ".validate": "newData.isString() && newData.val().length <= 10000"
        },
        "type": {
          ".validate": "newData.isString() && newData.val().length <= 50"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val())"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "services": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$serviceId": {
        ".validate": "!newData.exists() || newData.hasChildren(['title','name','type','updatedAt'])",
        "title": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "category": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "location": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "price": {
          ".validate": "newData.val() === null || newData.isNumber()"
        },
        "description": {
          ".validate": "newData.isString() && newData.val().length <= 10000"
        },
        "type": {
          ".validate": "newData.isString() && newData.val().length <= 50"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val())"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "venues": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$venueId": {
        ".validate": "!newData.exists() || newData.hasChildren(['title','name','type','updatedAt'])",
        "title": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "category": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "location": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "price": {
          ".validate": "newData.val() === null || newData.isNumber()"
        },
        "description": {
          ".validate": "newData.isString() && newData.val().length <= 10000"
        },
        "type": {
          ".validate": "newData.isString() && newData.val().length <= 50"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val())"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "locations": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$locationId": {
        ".validate": "!newData.exists() || newData.hasChildren(['title','name','type','updatedAt'])",
        "title": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "category": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "location": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "price": {
          ".validate": "newData.val() === null || newData.isNumber()"
        },
        "description": {
          ".validate": "newData.isString() && newData.val().length <= 10000"
        },
        "type": {
          ".validate": "newData.isString() && newData.val().length <= 50"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val())"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "contactEnquiries": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$enquiryId": {
        ".write": "(!data.exists() && newData.exists()) || (auth != null && root.child('admins').child(auth.uid).val() === true)",
        ".validate": "!newData.exists() || newData.hasChildren(['name','email','phone','subject','subjectKey','message','status','emailStatus','createdAt','updatedAt'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
        },
        "email": {
          ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$/) && newData.val().length <= 254"
        },
        "phone": {
          ".validate": "newData.isString() && newData.val().length <= 30"
        },
        "subject": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "subjectKey": {
          ".validate": "newData.isString() && newData.val().length <= 50"
        },
        "message": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 5000"
        },
        "status": {
          ".validate": "newData.val() === 'new' || (auth != null && root.child('admins').child(auth.uid).val() === true && (newData.val() === 'reviewed' || newData.val() === 'resolved'))"
        },
        "emailStatus": {
          ".validate": "newData.val() === 'pending' || newData.val() === 'sent' || newData.val() === 'failed'"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && (newData.val() === data.val() || !data.exists())"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        },
        "emailSentAt": {
          ".validate": "newData.isNumber()"
        },
        "reviewedAt": {
          ".validate": "newData.isNumber()"
        },
        "reviewedBy": {
          ".validate": "newData.isString() || newData.val() === null"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "reviewSubmissions": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$reviewId": {
        ".write": "(auth != null && !data.exists() && newData.exists()) || (auth != null && root.child('admins').child(auth.uid).val() === true)",
        ".validate": "!newData.exists() || newData.hasChildren(['name','review','rating','status','createdAt'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
        },
        "review": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 700"
        },
        "rating": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5"
        },
        "photoURL": {
          ".validate": "newData.isString() && newData.val().length <= 2048"
        },
        "photoPath": {
          ".validate": "newData.isString() && newData.val().length <= 300"
        },
        "status": {
          ".validate": "newData.val() === 'pending' || (auth != null && root.child('admins').child(auth.uid).val() === true && (newData.val() === 'published' || newData.val() === 'hidden'))"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && (newData.val() === data.val() || !data.exists())"
        },
        "publishedAt": {
          ".validate": "newData.isNumber()"
        },
        "publishedBy": {
          ".validate": "newData.isString() || newData.val() === null"
        },
        "publicId": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "moderatedAt": {
          ".validate": "newData.isNumber()"
        },
        "moderatedBy": {
          ".validate": "newData.isString() || newData.val() === null"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "publishedReviews": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".indexOn": [
        "publishedAt"
      ],
      "$reviewId": {
        ".validate": "!newData.exists() || newData.hasChildren(['name','review','rating','status','publishedAt'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
        },
        "review": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 700"
        },
        "rating": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5"
        },
        "status": {
          ".validate": "newData.val() === 'published'"
        },
        "publishedAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}